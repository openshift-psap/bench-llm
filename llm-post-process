import sys
import json
from dataclasses import dataclass, is_dataclass, asdict
from enum import Enum
from typing import Dict, List, Any, Optional, Tuple
from functools import reduce

def to_dict(a: Any):
    if hasattr(a, "to_dict"):
        return a.to_dict()
    elif is_dataclass(a):
        return asdict(a)
    else:
        raise TypeError(f"Cannot bring {a} to a dict")

def lookup(d: Dict[Any, Any], path: str, delim: str=".") -> Optional[Any]:
    try:
        segments = path.split(delim)
        return reduce(lambda td, seg: td[seg], segments, d)
    except KeyError:
        return None


"""
The following enums and dataclasses are datastructures
to represent various pieces of how Crucible expects to
find data. These are not specific to bench-llm, but are
structures to help us model what the output of the
post-processing needs to look like.
"""

class MetricClass(Enum):
    COUNT = "count"
    THROUGHPUT = "throughput"

@dataclass
class Desc:
    metric_class: MetricClass
    source: str
    metric_type: str

    def to_dict(self):
        return {
                "class": str(self.metric_class.value),
                "source": self.source,
                "type": self.metric_type,
            }
@dataclass
class Metric:
    idx: int
    desc: Desc
    names: Dict[str, str]

    def to_dict(self):
        return {
                "desc": to_dict(self.desc),
                "idx": self.idx,
                "names": self.names,
            }

@dataclass
class Period:
    name: str
    metric_files: List[str]

    def to_dict(self):
        return {
                "name": self.name,
                "metric-files": self.metric_files,
            }

@dataclass
class PostProcess:
    primary_period: str
    primary_metric: str
    benchmark: str
    periods: List[Period]
    rickshaw_bench_metric_version: str

    def to_dict(self):
        return {
                "primary-period": self.primary_period,
                "primary-metric": self.primary_metric,
                "benchmark": self.benchmark,
                "periods": [to_dict(period) for period in self.periods],
                "rickshaw-bench-metric": {
                    "schema": {
                        "version": self.rickshaw_bench_metric_version
                    }
                }
            }

@dataclass
class Entry:
    idx: int
    start: int
    end: int
    value: float

    def __str__(self):
        return f"{int(self.idx)},{int(self.start)},{int(self.end)},{float(self.value)}"

"""
Helpers specific to guidellm and bench-llm
"""

@dataclass
class Phase():
    """
    An execution of a guidellm strategy. A rate-type of `sweep` will result in multiple
    runs, each using a different strategy. A constant/poisson/etc rate-type is a degenerate
    form of this sweep where there is only one run, using one strategy.
    There is a one-to-one correspondence between `Phase`'s and CDM `Period`'s. Each `Phase`
    will be given its own CDM `Period`.
    """
    name: str
    idx: int # "metric-data-[0-9]+"

def flatten_dict(d: Any, sep="_", prefix="") -> List[Tuple[str, float]]:
    pairs = []
    if type(d) is float:
        pairs.append((prefix, d))
    elif type(d) is dict:
        for k, v in d.items():
            pairs.extend(flatten_dict(v, sep=sep, prefix=(prefix + sep + k)))

    return pairs


def safe_name(name: str) -> str:
    return name.lower().replace("_", "-")

PROFILE_TYPE_MAP = {
    "async": 0.0,
    "sweep": 1.0,
    "concurrent": 2.0,
    "throughput": 3.0,
    "synchronous": 4.0,
    "profile": 5.0,
}

STRATEGY_TYPE_MAP = {
    "concurrent": 0.0,
    "strategy": 1.0,
    "throughput": 2.0,
    "synchronous": 3.0,
    "poisson": 4.0,
    "constant": 5.0,
}

def safe_get(d, *path):
    """Safely get nested dictionary values."""
    for p in path:
        if not isinstance(d, dict) or p not in d:
            return None
        d = d[p]
    return d

def safe_measured_rate(args):
    """Safely get measured rate from profile or calculate from metrics."""
    profile = args.get("profile", {})
    idx = int(args.get("strategy_index", 0))
    # Check if measured_rates exists and is a list (old format)
    if "measured_rates" in profile and isinstance(profile["measured_rates"], list):
        rates = profile["measured_rates"]
        return rates[idx] if idx < len(rates) else None
    # New format: rate is in args.rate as a list
    if "rate" in args and isinstance(args["rate"], list):
        rates = args["rate"]
        return rates[idx] if idx < len(rates) else None
    return None

def safe_measured_concurrency(args):
    """Safely get measured concurrency from profile or strategy."""
    profile = args.get("profile", {})
    strategy = args.get("strategy", {})
    idx = int(args.get("strategy_index", 0))
    # Check if measured_concurrencies exists and is a list (old format)
    if "measured_concurrencies" in profile and isinstance(profile["measured_concurrencies"], list):
        conc = profile["measured_concurrencies"]
        return conc[idx] if idx < len(conc) else None
    # New format: max_concurrency is in strategy
    if "max_concurrency" in strategy:
        return strategy["max_concurrency"]
    return None

def parse_phase(results: Dict[str, Any], phase: Phase, period: Period):
    benchmark = results["benchmarks"][phase.idx]

    # Args are now at top level, but we also need config info from benchmark
    top_level_args = results.get("args", {})
    config = benchmark.get("config", {})

    # Merge top-level args with config info for backward compatibility
    # Config has strategy and profile nested, so we need to extract them
    args = top_level_args.copy()
    if config:
        # Add strategy info from config
        if "strategy" in config:
            args["strategy"] = config["strategy"]
        # Add profile info from config
        if "profile" in config:
            args["profile"] = config["profile"]
            # For strategy_index, use run_index from config
            args["strategy_index"] = config.get("run_index", 0)

    # Metrics are now a flat dict directly in benchmark["metrics"]
    data = benchmark.get("metrics", {})

    # Scheduler metrics (replaces run_stats)
    scheduler_metrics = benchmark.get("scheduler_metrics", {})

    json_path = period.metric_files[0] + ".json"
    csv_path = period.metric_files[0] + ".csv"

    # Guidellm gives floating point seconds, we need integer millis
    start_time = int(float(benchmark["start_time"])) * 1000
    end_time = int(float(benchmark["end_time"])) * 1000

    # All the metrics we are going to try to look for. Each of these might resolve to multiple
    # metrics with different suffixes.
    args_classes = [
        ("target_rps", MetricClass.THROUGHPUT, lambda x: (x.get("rate", [None])[0] if isinstance(x.get("rate"), list) and len(x.get("rate", [])) > 0 else safe_get(x, "strategy", "rate"))),
        ("measured_rps", MetricClass.THROUGHPUT, lambda x: safe_measured_rate(x)),
        ("measured_concurrency", MetricClass.COUNT, lambda x: safe_measured_concurrency(x)),
        ("profile_type", MetricClass.COUNT, lambda x: PROFILE_TYPE_MAP.get(safe_get(x, "profile", "type_"), None) if safe_get(x, "profile", "type_") else None),
        ("strategy_type", MetricClass.COUNT, lambda x: STRATEGY_TYPE_MAP.get(safe_get(x, "strategy", "type_"), None) if safe_get(x, "strategy", "type_") else None),
    ]
    kpi_classes = [
        ("inter_token_latency_ms", MetricClass.COUNT),
        ("output_token_count", MetricClass.COUNT),
        ("output_tokens_per_second", MetricClass.THROUGHPUT),
        ("prompt_token_count", MetricClass.COUNT),
        ("request_concurrency", MetricClass.COUNT),
        ("request_latency", MetricClass.COUNT),
        ("requests_per_second", MetricClass.THROUGHPUT),
        ("time_per_output_token_ms", MetricClass.COUNT),
        ("time_to_first_token_ms", MetricClass.COUNT),
        ("tokens_per_second", MetricClass.THROUGHPUT),
    ]
    run_stats_classes = [
        ("worker_start_delay_avg", MetricClass.COUNT),
        ("worker_start_time_targeted_delay_avg", MetricClass.COUNT),
        ("worker_time_avg", MetricClass.COUNT),
        ("request_start_time_delay_avg", MetricClass.COUNT),
        ("request_start_time_targeted_delay_avg", MetricClass.COUNT),
        ("request_time_avg", MetricClass.COUNT),
        ("request_time_delay_avg", MetricClass.COUNT),
        ("requests_made", MetricClass.COUNT),
        ("scheduled_time_delay_avg", MetricClass.COUNT),
        ("scheduled_time_sleep_avg", MetricClass.COUNT),
        ("queued_time_avg", MetricClass.COUNT),
    ]

    # Build metrics list
    metrics: List[Metric] = []
    pairs = []
    idx_map = {}
    next_free_metric_idx = 0

    for arg in args_classes:
        try:
            idx_map[arg[0]] = next_free_metric_idx
            value = arg[2](args)
            if value is None:
                continue
            metrics.append(Metric(next_free_metric_idx, Desc(arg[1], "llm", safe_name(arg[0])), {}))
            pairs.append((arg[0], float(value)))
        except Exception as e:
            print(f"WARNING: Can't parse arg {e}")
            continue
        finally:
            next_free_metric_idx += 1

    for kpi in kpi_classes:
        if kpi[0] not in data:
            continue
        metric_values = flatten_dict(data[kpi[0]], prefix=kpi[0])
        for name, value in metric_values:
            if value is None:
                continue

            # NEW FIX — skip dict/list/non-numeric values
            if not isinstance(value, (int, float)):
                continue

            metrics.append(Metric(next_free_metric_idx, Desc(kpi[1], "llm", safe_name(name)), {}))
            idx_map[name] = next_free_metric_idx
            pairs.append((name, float(value)))
            next_free_metric_idx += 1


    # Map old run_stats field names to new scheduler_metrics field names
    scheduler_metrics_mapping = {
        "worker_start_delay_avg": "resolve_start_delay_avg",
        "worker_start_time_targeted_delay_avg": "resolve_targeted_start_delay_avg",
        "worker_time_avg": "resolve_time_avg",
        "request_start_time_delay_avg": "request_start_delay_avg",
        "request_start_time_targeted_delay_avg": "request_targeted_start_delay_avg",
        "request_time_avg": "request_time_avg",
        "request_time_delay_avg": "resolve_end_delay_avg",
        "requests_made": "requests_made",
        "scheduled_time_delay_avg": "processed_delay_avg",
        "scheduled_time_sleep_avg": None,  # Not in new structure
        "queued_time_avg": "queued_time_avg",
    }

    for run_stat in run_stats_classes:
        old_name = run_stat[0]
        new_name = scheduler_metrics_mapping.get(old_name)
        if new_name is None:
            # Field doesn't exist in new structure, skip
            continue
        if new_name not in scheduler_metrics:
            continue
        value = scheduler_metrics[new_name]
        if value is None:
            continue

        if not isinstance(value, (int, float)):
            continue

        metrics.append(Metric(next_free_metric_idx, Desc(run_stat[1], "llm", safe_name(old_name)), {}))
        idx_map[old_name] = next_free_metric_idx
        pairs.append((old_name, float(value)))
        next_free_metric_idx += 1

    with open(json_path, "w") as f:
        f.write(json.dumps([to_dict(metric) for metric in metrics], indent=4))

    # Build entry list
    entries: List[Entry] = []
    for pair in pairs:
        entries.append(Entry(idx_map[pair[0]], start_time, end_time, pair[1]))

    with open(csv_path, "w") as f:
        f.write("\n".join([str(entry) for entry in entries]))

    return next_free_metric_idx

def main():

    # First, load the output json file. It will be required
    # to determine the structure of the payload as well as
    # actually containing the data
    output = {}
    with open("output.json", "r") as f:
        output = json.load(f)

    # In any benchmark post-process script, the metrics generated need to be attributed to a
    # time-period (AKA benchmark-phase).  The period which is used to report and offical
    # result for the benchmark is the 'measurement' period.  Other periods thay may exist
    # could be "warm-up", "prep", etc.

    # There are 3 important phases to the post-processing here...

    # 1. Generate the 'post-process-data.json` file which describes where to find
    #   our processed data and includes some metadata

    periods: List[Period] = [Period(f"p{i}", [f"metric-data-{i}"]) for i in range(len(output["benchmarks"]))]
    phases: List[Phase] = [Phase(f"p{i}", i) for i in range(len(output["benchmarks"]))]

    for phase, period in zip(phases, periods):
        parse_phase(output, phase, period)

    post_process_config = PostProcess(
        periods[0].name,
        safe_name("measured_rps"),
        "llm",
        periods,
        '2021.04.12',
    )

    with open("post-process-data.json", "w") as f:
        f.write(json.dumps(to_dict(post_process_config), indent=4))


    return 0


if __name__ == "__main__":
    sys.exit(main())
